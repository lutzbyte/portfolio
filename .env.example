# URL publik website. Dipakai untuk canonical, sitemap, robots, dan Open Graph.
# Lokal: http://localhost:3000 | Produksi: isi dengan domain finalmu.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Diisi di Fase 9 setelah kamu mendapat token dari
# Google Search Console dan Bing Webmaster Tools. Biarkan kosong sebelum itu.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Opsional, hanya jika memakai IndexNow (Fase 9). Biarkan kosong sebelum itu.
INDEXNOW_KEY=

# Form kontak (Fase 6), dikirim lewat Resend (https://resend.com).
# Selama salah satu kosong, form menampilkan pesan "belum dikonfigurasi".
# RESEND_API_KEY : API key dari dashboard Resend.
# CONTACT_FROM_EMAIL : pengirim yang diizinkan Resend (domain terverifikasi,
#                      atau alamat uji dari Resend untuk percobaan).
# CONTACT_TO_EMAIL : email tujuanmu, tempat pesan masuk.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=